{
  "name": "@local/sensory-memory",
  "version": "0.6.0-debug-interfaces",
  "description": "Scoped sensory memory with prompt-layer debug tools for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./sensory-index": "./lib/sensory-index.js",
    "./extraction-engine": "./lib/extraction-engine.js",
    "./demotion-engine": "./lib/demotion-engine.js",
    "./match-engine": "./lib/match-engine.js",
    "./injection-engine": "./lib/injection-engine.js",
    "./llm-extractor": "./lib/llm-extractor.js",
    "./halu-mem-auditor": "./lib/halu-mem-auditor.js",
    "./fallback-rewriter": "./lib/fallback-rewriter.js",
    "./semipersistent-cache": "./lib/semipersistent-cache.js",
    "./stage4-llm": "./lib/stage4-llm.js",
    "./sensory-tools": "./lib/sensory-tools.js",
    "./sensory-debug": "./lib/sensory-debug.js",
    "./sensory-maintenance": "./lib/sensory-maintenance.js",
    "./atomic-files": "./lib/atomic-files.js",
    "./engram-adapter": "./lib/engram-adapter.js",
    "./hash": "./lib/hash.js"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.0.1-rc"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "sensory_recall",
        "sensory_open",
        "sensory_store",
        "sensory_demote",
        "sensory_status",
        "sensory_audit",
        "sensory_cache_status",
        "sensory_debug_last_prompt",
        "sensory_debug_cache_prompt",
        "sensory_debug_index_prompt",
        "sensory_debug_working_prompt",
        "sensory_clear_workspace_index"
      ],
      "skills": []
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "inspect:index": "node ./test/populate-index.mjs"
  },
  "license": "UNLICENSED",
  "private": true
}
